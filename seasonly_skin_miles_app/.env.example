# Copy to .env and fill in. Never commit the real .env.
PORT=3000
NODE_ENV=production
# Behind a reverse proxy / PaaS that terminates HTTPS:
TRUST_PROXY=1

# Admin panel (/admin)
ADMIN_EMAIL=admin@seasonly.fr
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Where the SQLite database and the photo encryption key live (mount a persistent volume here)
DATA_DIR=./data
# Optional: 64 hex chars. If unset, a key is generated in DATA_DIR/image.key — back it up.
IMAGE_KEY=

# Email (any SMTP provider: Brevo, Mailjet, SendGrid, Amazon SES, OVH…)
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Seasonly <hello@seasonly.fr>

# SMS codes via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+33XXXXXXXXX
# or a messaging service / alphanumeric sender:
TWILIO_MESSAGING_SERVICE_SID=

# Web push (optional: generated automatically on first start and stored in the database)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@seasonly.fr

# Development only: show sign-up codes on screen instead of requiring SMS/email (ignored when NODE_ENV=production)
DEV_SHOW_CODES=0
